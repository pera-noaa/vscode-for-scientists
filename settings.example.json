// Example VSCode settings for scientific computing.
//
// To use: open VSCode -> Cmd+Shift+P -> "Preferences: Open User Settings (JSON)"
// and merge whichever sections you want.
//
// Project-specific overrides go in <project>/.vscode/settings.json — keep them
// version-controlled with the project.

{
    // ---------- Editor ----------
    "editor.formatOnSave": true,
    "editor.rulers": [80, 100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.renderWhitespace": "boundary",
    "editor.linkedEditing": true,
    "editor.suggestSelection": "first",
    "editor.inlineSuggest.enabled": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // ---------- Workbench ----------
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.tree.indent": 16,

    // ---------- Terminal ----------
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.copyOnSelection": true,

    // ---------- Python ----------
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "python.testing.pytestEnabled": true,
    "python.terminal.activateEnvironment": true,
    "jupyter.askForKernelRestart": false,

    // ---------- Fortran ----------
    "[fortran]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[FortranFreeForm]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // ---------- Markdown ----------
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        }
    },

    // ---------- LaTeX ----------
    "[latex]": {
        "editor.wordWrap": "on",
        "editor.formatOnSave": false
    },
    "latex-workshop.view.pdf.viewer": "tab",

    // ---------- Git ----------
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": true,

    // ---------- Files: exclude noise from the file tree ----------
    "files.exclude": {
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ipynb_checkpoints": true,
        "**/*.pyc": true,
        "**/.ruff_cache": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/__pycache__": true,
        "**/*.aux": true,
        "**/*.log": true,
        "**/*.bbl": true
    },

    // ---------- Remote-SSH ----------
    // Uncomment and edit for your slow-shared-home HPC hosts.
    // "remote.SSH.serverInstallPath": {
    //     "nimbus": "/scratch/your_username"
    // },
    "remote.SSH.connectTimeout": 30,
    "remote.SSH.showLoginTerminal": true,

    // ---------- Spell check (prose, comments, docstrings) ----------
    "cSpell.language": "en-US",
    "cSpell.words": [
        "netcdf",
        "obspack",
        "calibrated",
        "ifort",
        "ifx",
        "gfortran",
        "TM5",
        "EnKF"
    ]
}
